# Environment variables for development
DPP_ENVIRONMENT=dev
DPP_DEBUG=True
DPP_LOG_LEVEL=INFO


# AI Provider Selection & Configuration
DPP_AI_PROVIDER=nvidia
DPP_OLLAMA_BASE_URL=http://localhost:11434
DPP_OLLAMA_API_KEY=

# Auth & Security
DPP_ADMIN_API_KEY=
DPP_JWT_SECRET_KEY=


# Database Components (Point to localhost for Docker container)
DPP_DATABASE_HOST=localhost
DPP_DATABASE_PORT=5432
DPP_DATABASE_USER=pulsar_user
DPP_DATABASE_PASSWORD=
DPP_DATABASE_NAME=pulsar_estate


# RabbitMQ Components (Point to localhost for Docker container)
DPP_RABBITMQ_HOST=localhost
DPP_RABBITMQ_PORT=5672
DPP_RABBITMQ_MANAGEMENT_PORT=15672
DPP_RABBITMQ_USER=guest
DPP_RABBITMQ_PASSWORD=

# Redis Components (Point to localhost for Docker container)
DPP_REDIS_HOST=localhost
DPP_REDIS_PORT=6379


# Embedding Provider Settings
DPP_EMBEDDING_DIMENSION=384
DPP_HF_API_KEY=
DPP_NVIDIA_API_KEY=

# Rate Limiting Configuration
REDIS_URL=redis://127.0.0.1:6379/0
TRUSTED_PROXY_IPS=172.18.0.2        # your reverse-proxy container IP
RATE_LIMIT_DEFAULT_FALLBACK=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_PIPELINE=10/minute
RATE_LIMIT_INTEGRATIONS=20/minute
